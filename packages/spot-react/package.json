{
  "name": "@orbs-network/spot-react",
  "version": "2.0.0",
  "description": "Spot React Components - React components for Spot SDK",
  "type": "module",
  "main": "./dist/spot-react.umd.cjs",
  "module": "./dist/spot-react.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/spot-react.js",
      "require": "./dist/spot-react.umd.cjs"
    },
    "./styles.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc && vite build",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "spot",
    "ui",
    "react",
    "components"
  ],
  "license": "MIT",
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@orbs-network/spot-ui": "workspace:*",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@types/react": "^19.0.2",
    "react": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-dts": "^4.4.0",
    "vitest": "^3.2.7"
  }
}
