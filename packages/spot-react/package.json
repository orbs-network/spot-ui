{
  "name": "@orbs-network/spot-react",
  "version": "2.1.26",
  "description": "Spot React Components - React components for Spot SDK",
  "type": "module",
  "main": "./dist/spot-react.umd.cjs",
  "module": "./dist/spot-react.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/spot-react.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/spot-react.umd.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc && vite build && node ../../scripts/package-integration-skill.mjs spot-react",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "spot",
    "ui",
    "react",
    "components"
  ],
  "license": "MIT",
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@orbs-network/spot-ui": "workspace:*",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@types/react": "^19.0.2",
    "@types/react-dom": "19.2.3",
    "jsdom": "26.1.0",
    "react": "^19.2.3",
    "react-dom": "19.2.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-dts": "^4.4.0",
    "vitest": "^3.2.7"
  }
}
