{
  "name": "@orbs-network/spot-ui",
  "version": "2.1.29",
  "description": "Framework-neutral SDK for Spot swap quotes, order calculation, signing payloads, submission, and order status.",
  "type": "module",
  "main": "./dist/spot-ui.umd.cjs",
  "module": "./dist/spot-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/spot-ui.js",
      "require": "./dist/spot-ui.umd.cjs"
    }
  },
  "files": [
    "dist",
    "examples",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc && vite build && tsc -p tsconfig.examples.json && node ../../scripts/package-integration-skill.mjs spot-ui",
    "typecheck:examples": "tsc -p tsconfig.examples.json",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "spot",
    "sdk"
  ],
  "license": "MIT",
  "devDependencies": {
    "bignumber.js": "^9.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-dts": "^4.4.0",
    "vitest": "^3.2.7"
  }
}
